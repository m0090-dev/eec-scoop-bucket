{
    "version": "1.0.1",
    "description": "env-exec: Environment Execution Controller",
    "homepage": "https://github.com/m0090-dev/eec",
    "license": "MIT",
    "post_install": [
    	"eec gen script --output \"$env:USERPROFILE\\scoop\\shims\""
	],
	"pre_uninstall": [
    	"eec gen script --clean --output \"$env:USERPROFILE\\scoop\\shims\""
	],
    "architecture": {
        "64bit": {
            "url": "https://github.com/m0090-dev/eec/releases/download/v1.0.1/eec-v1.0.1-windows.zip",
            "bin": ["eec.exe", "eec-deleter.exe"]
        }
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/m0090-dev/eec/releases/download/v$version/eec-v$version-windows.zip",
		"hash": {
                	"url": "$url.sha256"
            	}
            }
        }
    }
}
